<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows-Version von LLM Duell (WPF).
    Ziel ist .NET Framework 4.8: Es ist in Windows 10 (ab 1903) und Windows 11 enthalten,
    die App braucht daher keine zusätzliche Laufzeit und besteht aus einer einzigen kleinen EXE.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>LLMDuell</RootNamespace>
    <AssemblyName>LLMDuell</AssemblyName>
    <Version>1.1.0</Version>
    <Product>LLM Duell</Product>
    <AssemblyTitle>LLM Duell</AssemblyTitle>
    <Company>Sandro Leidmann</Company>
    <Copyright>© Sandro Leidmann · GPL-3.0</Copyright>
    <Description>Zwei lokale Ollama-Modelle im direkten Vergleich</Description>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <!-- JSON (JavaScriptSerializer); System.Web wird davon referenziert und vom XAML-Compiler verlangt. -->
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Resource Include="Resources\AppIcon.ico" />
  </ItemGroup>

</Project>
