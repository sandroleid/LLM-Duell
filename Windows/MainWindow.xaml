<Window x:Class="LLMDuell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LLMDuell"
        Title="LLM Duell" Icon="Resources/AppIcon.ico"
        Width="1320" Height="960" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        PreviewKeyDown="OnWindowKeyDown">
    <Grid x:Name="Root" Background="{DynamicResource WindowBg}">

        <!-- Farbiger Schimmer in den Ecken, je einer pro Seite -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="0.6" RadiusY="0.85">
                    <GradientStop Color="#2B5485FF" Offset="0" />
                    <GradientStop Color="#005485FF" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="0.6" RadiusY="0.85">
                    <GradientStop Color="#26FF618C" Offset="0" />
                    <GradientStop Color="#00FF618C" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="18,8,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Kopfzeile -->
            <Grid Grid.Row="0" Height="44" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource LogoGradient}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="15" Foreground="White" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="LLM Duell" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Lokale Modelle im direkten Vergleich" FontSize="12" Foreground="{DynamicResource Text2}" />
                </StackPanel>

                <Border x:Name="ConnectionPill" Grid.Column="2" CornerRadius="14" Padding="11,0" Height="28"
                        Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                        VerticalAlignment="Center" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ConnectionDot" Width="7" Height="7" VerticalAlignment="Center" />
                        <TextBlock x:Name="ConnectionText" FontSize="12" FontWeight="Medium" Margin="7,0,0,1" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button x:Name="SwapButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE8AB;"
                        ToolTip="Modelle tauschen (Strg+Umschalt+T)" Click="OnSwap" />
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE72C;"
                        ToolTip="Modellliste aktualisieren (F5)" Click="OnRefresh" />
                <Button x:Name="OptionsButton" Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xE713;"
                        ToolTip="Optionen" Click="OnToggleOptions" />
            </Grid>

            <!-- Die beiden Modelle -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:ModelPanel x:Name="LeftPanel" Grid.Column="0" />
                <local:ModelPanel x:Name="RightPanel" Grid.Column="2" />
            </Grid>

            <!-- Direkter Vergleich -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center">
                            <Run x:Name="CompareLeftSpeed" FontSize="20" FontWeight="Bold" Foreground="{StaticResource LeftGradient}" Text="0,0" />
                            <Run Text="tok/s" FontSize="12" Foreground="{DynamicResource Text2}" />
                        </TextBlock>
                        <TextBlock x:Name="Verdict" Grid.Column="1" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right">
                            <Run x:Name="CompareRightSpeed" FontSize="20" FontWeight="Bold" Foreground="{StaticResource RightGradient}" Text="0,0" />
                            <Run Text="tok/s" FontSize="12" Foreground="{DynamicResource Text2}" />
                        </TextBlock>
                    </Grid>

                    <Grid x:Name="DuelBar" Height="8" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="DuelLeft" Width="*" MinWidth="4" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition x:Name="DuelRight" Width="*" MinWidth="4" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="4" Background="{StaticResource LeftGradient}" />
                        <Border Grid.Column="2" CornerRadius="4" Background="{StaticResource RightGradient}" />
                    </Grid>

                    <StackPanel x:Name="CompareRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock FontSize="12" Margin="9,0">
                            <Run Text="Erstes Token" Foreground="{DynamicResource Text3}" />
                            <Run x:Name="CompareFirstA" Foreground="{StaticResource LeftBrush}" FontWeight="SemiBold" />
                            <Run Text="vs" Foreground="{DynamicResource Text3}" />
                            <Run x:Name="CompareFirstB" Foreground="{StaticResource RightBrush}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock FontSize="12" Margin="9,0">
                            <Run Text="Output-Tokens" Foreground="{DynamicResource Text3}" />
                            <Run x:Name="CompareOutputA" Foreground="{StaticResource LeftBrush}" FontWeight="SemiBold" />
                            <Run Text="vs" Foreground="{DynamicResource Text3}" />
                            <Run x:Name="CompareOutputB" Foreground="{StaticResource RightBrush}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock FontSize="12" Margin="9,0">
                            <Run Text="Tokens gesamt" Foreground="{DynamicResource Text3}" />
                            <Run x:Name="CompareTotalA" Foreground="{StaticResource LeftBrush}" FontWeight="SemiBold" />
                            <Run Text="vs" Foreground="{DynamicResource Text3}" />
                            <Run x:Name="CompareTotalB" Foreground="{StaticResource RightBrush}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock FontSize="12" Margin="9,0">
                            <Run Text="Gesamtdauer" Foreground="{DynamicResource Text3}" />
                            <Run x:Name="CompareDurationA" Foreground="{StaticResource LeftBrush}" FontWeight="SemiBold" />
                            <Run Text="vs" Foreground="{DynamicResource Text3}" />
                            <Run x:Name="CompareDurationB" Foreground="{StaticResource RightBrush}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Eingabe -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PromptBorder" CornerRadius="14" Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="15,0,6,0" MinHeight="46">
                    <Grid>
                        <TextBlock x:Name="PromptHint" Text="Prompt eingeben – beide Modelle erhalten denselben Text"
                                   FontSize="14" Foreground="{DynamicResource Text3}" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBox x:Name="PromptBox" Style="{StaticResource BareText}" FontSize="14" AcceptsReturn="True"
                                 MaxHeight="132" Padding="0,12" VerticalAlignment="Center" VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnPromptChanged" PreviewKeyDown="OnPromptKeyDown"
                                 GotKeyboardFocus="OnPromptFocusChanged" LostKeyboardFocus="OnPromptFocusChanged" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource ChipBg}" CornerRadius="9" Padding="2" Margin="10,0,10,7"
                        VerticalAlignment="Bottom" Height="32"
                        ToolTip="Nacheinander misst fairer, weil sich die Modelle GPU und Speicher nicht teilen.">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ModeSequential" Style="{StaticResource Segment}" Content="Nacheinander" GroupName="ModeMain" Checked="OnModeChanged" />
                        <RadioButton x:Name="ModeParallel" Style="{StaticResource Segment}" Content="Parallel" GroupName="ModeMain" Checked="OnModeChanged" />
                    </StackPanel>
                </Border>

                <Button x:Name="StartButton" Grid.Column="2" Style="{StaticResource GradientButton}" Background="{StaticResource DuelGradient}"
                        VerticalAlignment="Bottom" Click="OnStart" ToolTip="Vergleich starten (Eingabetaste)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13" Margin="0,1,8,0" />
                        <TextBlock Text="Vergleichen" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Grid.Column="2" Style="{StaticResource GradientButton}" Background="{StaticResource StopGradient}"
                        VerticalAlignment="Bottom" Click="OnStop" Visibility="Collapsed" ToolTip="Abbrechen (Esc)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="13" Margin="0,1,8,0" />
                        <TextBlock Text="Stoppen" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Optionen -->
        <Popup x:Name="OptionsPopup" PlacementTarget="{Binding ElementName=OptionsButton}" Placement="Bottom"
               HorizontalOffset="-380" VerticalOffset="-4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Closed="OnOptionsClosed">
            <Grid Margin="12" Width="400" TextElement.Foreground="{DynamicResource Text}" TextElement.FontFamily="Segoe UI" TextElement.FontSize="13">
                <Border CornerRadius="14" Background="{DynamicResource PopupBg}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="14" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="18">
                    <StackPanel x:Name="OptionsContent">

                        <TextBlock Style="{StaticResource SectionTitle}" Text="VERBINDUNG" />
                        <TextBox x:Name="HostBox" Style="{StaticResource Input}" KeyDown="OnHostKeyDown" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Verbinden &amp; Modelle laden" Margin="0,8,0,0" Click="OnConnect" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="GENERIERUNG" Margin="0,20,0,8" />
                        <Grid>
                            <TextBlock Text="Ablauf" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource ChipBg}" CornerRadius="9" Padding="2" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="OptionSequential" Style="{StaticResource Segment}" Content="Nacheinander" GroupName="ModeOptions" Checked="OnModeChanged" />
                                    <RadioButton x:Name="OptionParallel" Style="{StaticResource Segment}" Content="Parallel" GroupName="ModeOptions" Checked="OnModeChanged" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Temperatur" VerticalAlignment="Center" />
                            <Slider x:Name="TemperatureSlider" Grid.Column="1" Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.25"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" Focusable="False"
                                    ValueChanged="OnTemperatureChanged" />
                            <TextBlock x:Name="TemperatureValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,12,0,0" Height="32">
                            <CheckBox x:Name="SeedCheck" Content="Fester Seed" Foreground="{DynamicResource Text}" VerticalAlignment="Center"
                                      VerticalContentAlignment="Center" Focusable="False" Checked="OnSeedToggled" Unchecked="OnSeedToggled" />
                            <TextBox x:Name="SeedBox" Style="{StaticResource Input}" Width="120" HorizontalAlignment="Right"
                                     VerticalAlignment="Center" TextAlignment="Right" TextChanged="OnSeedChanged" />
                        </Grid>
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource Text2}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="„Nacheinander“ misst fairer, da sich die Modelle GPU und Speicher nicht teilen. Ein fester Seed macht Läufe reproduzierbar." />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="SYSTEM-PROMPT (OPTIONAL)" Margin="0,20,0,8" />
                        <TextBox x:Name="SystemPromptBox" Style="{StaticResource Input}" Height="74" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" TextChanged="OnSystemPromptChanged" />

                        <Button Style="{StaticResource SecondaryButton}" Content="Session-Statistik zurücksetzen" Margin="0,20,0,0"
                                Foreground="{StaticResource ErrorBrush}" Click="OnResetSession" />
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</Window>
