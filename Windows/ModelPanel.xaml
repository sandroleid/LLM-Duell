<UserControl x:Class="LLMDuell.ModelPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LLMDuell">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile: Buchstabe, Modellauswahl, Status -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="LetterTile" Width="30" Height="30" CornerRadius="9" VerticalAlignment="Center">
                <TextBlock x:Name="LetterText" Foreground="White" FontSize="14" FontWeight="ExtraBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                <ComboBox x:Name="ModelBox" Style="{StaticResource ModelCombo}" HorizontalAlignment="Left"
                          SelectionChanged="OnModelSelected" />
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0" Height="18">
                    <Border x:Name="ChipParams" Style="{StaticResource Chip}">
                        <TextBlock x:Name="ChipParamsText" FontSize="11" Foreground="{DynamicResource Text2}" />
                    </Border>
                    <Border x:Name="ChipQuant" Style="{StaticResource Chip}">
                        <TextBlock x:Name="ChipQuantText" FontSize="11" Foreground="{DynamicResource Text2}" />
                    </Border>
                    <Border x:Name="ChipSize" Style="{StaticResource Chip}">
                        <TextBlock x:Name="ChipSizeText" FontSize="11" Foreground="{DynamicResource Text2}" />
                    </Border>
                </StackPanel>
            </StackPanel>
            <Border x:Name="PhaseBadge" Grid.Column="2" CornerRadius="13" Padding="10,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PhaseIcon" Style="{StaticResource Icon}" FontSize="12" />
                    <TextBlock x:Name="PhaseText" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Geschwindigkeit und Tokens -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;" FontSize="12" Foreground="{DynamicResource Text2}" Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource Caption}" Text="Geschwindigkeit" />
                    </StackPanel>
                    <TextBlock Margin="0,-2,0,0">
                        <Run x:Name="SpeedValue" FontSize="42" FontWeight="Bold" Text="0,0" />
                        <Run Text="tok/s" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text2}" />
                    </TextBlock>
                    <TextBlock x:Name="SpeedCaption" FontSize="11" Foreground="{DynamicResource Text3}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="#" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text2}" Margin="1,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Caption}" Text="Tokens" />
                    </StackPanel>
                    <TextBlock Margin="0,-2,0,0">
                        <Run x:Name="TokenValue" FontSize="42" FontWeight="Bold" Text="0" />
                        <Run Text="Output" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text2}" />
                    </TextBlock>
                    <TextBlock FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis">
                        <Run Text="Prompt" Foreground="{DynamicResource Text3}" />
                        <Run x:Name="TokenPrompt" Foreground="{DynamicResource Text2}" />
                        <Run Text="   Gesamt" Foreground="{DynamicResource Text3}" />
                        <Run x:Name="TokenTotal" Foreground="{DynamicResource Text2}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Zeiten -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardSmall}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Text="Erstes Token" />
                    <TextBlock x:Name="FirstTokenValue" FontSize="14.5" FontWeight="SemiBold" Margin="0,2,0,0" Text="–" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardSmall}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Text="Ladezeit" />
                    <TextBlock x:Name="LoadValue" FontSize="14.5" FontWeight="SemiBold" Margin="0,2,0,0" Text="–" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardSmall}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Text="Prompt-Verarb." />
                    <TextBlock x:Name="PromptSpeedValue" FontSize="14.5" FontWeight="SemiBold" Margin="0,2,0,0" Text="–"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource CardSmall}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Text="Dauer" />
                    <TextBlock x:Name="DurationValue" FontSize="14.5" FontWeight="SemiBold" Margin="0,2,0,0" Text="–" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Diagramm -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <TextBlock Style="{StaticResource Caption}" Text="Tokens pro Sekunde über Zeit" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ChartAverage" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </Grid>
                <local:SpeedChart x:Name="Chart" Height="88" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Ausgabe -->
        <Border x:Name="OutputBorder" Grid.Row="4" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="OnScrollWheel" Margin="0,4">
                <StackPanel Margin="16,12,10,12">

                    <!-- Gedankengang von Reasoning-Modellen -->
                    <Border x:Name="ThinkingBox" CornerRadius="10" Padding="10" Background="#14A855F7" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <Button Style="{StaticResource PlainButton}" Click="OnToggleThinking" Cursor="Hand">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="12" Foreground="{DynamicResource Text2}" />
                                        <TextBlock x:Name="ThinkingTitle" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text2}" Margin="6,0,8,0" />
                                        <TextBlock x:Name="ThinkingCount" FontSize="12" Foreground="{DynamicResource Text3}" />
                                    </StackPanel>
                                    <TextBlock x:Name="ThinkingChevron" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10"
                                               Foreground="{DynamicResource Text2}" HorizontalAlignment="Right" />
                                </Grid>
                            </Button>
                            <TextBox x:Name="ThinkingText" Style="{StaticResource BareText}" IsReadOnly="True" FontSize="12"
                                     Foreground="{DynamicResource Text2}" Margin="0,8,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- Platzhalter, solange noch keine Antwort da ist -->
                    <StackPanel x:Name="Placeholder" MinHeight="150" VerticalAlignment="Center" Margin="0,40,0,0">
                        <TextBlock x:Name="PlaceholderIcon" Style="{StaticResource Icon}" FontSize="26" HorizontalAlignment="Center" />
                        <TextBlock x:Name="PlaceholderText" FontSize="13.5" Foreground="{DynamicResource Text2}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>

                    <RichTextBox x:Name="OutputBox" IsReadOnly="True" IsUndoEnabled="False" BorderThickness="0" Padding="0"
                                 Background="Transparent" Foreground="{DynamicResource Text}" FontSize="13.5"
                                 SelectionBrush="{StaticResource LeftBrush}" VerticalScrollBarVisibility="Disabled"
                                 Visibility="Collapsed">
                        <RichTextBox.Template>
                            <ControlTemplate TargetType="RichTextBox">
                                <ScrollViewer x:Name="PART_ContentHost" />
                            </ControlTemplate>
                        </RichTextBox.Template>
                    </RichTextBox>

                    <Border x:Name="ErrorBox" CornerRadius="10" Padding="10" Background="#18E5484D" Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="14" Foreground="{StaticResource ErrorBrush}"
                                       VerticalAlignment="Top" Margin="0,2,8,0" />
                            <TextBox x:Name="ErrorText" Grid.Column="1" Style="{StaticResource BareText}" IsReadOnly="True"
                                     FontSize="13.5" Foreground="{StaticResource ErrorBrush}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Summen der Session -->
        <Grid Grid.Row="5" Margin="4,10,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="12" Foreground="{DynamicResource Text2}" TextTrimming="CharacterEllipsis">
                <Run Text="Σ Session:" FontWeight="SemiBold" />
                <Run x:Name="SessionSummary" />
                <Run x:Name="SessionDetail" Foreground="{DynamicResource Text3}" />
            </TextBlock>
            <TextBlock x:Name="SessionAverage" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" />
        </Grid>
    </Grid>
</UserControl>
